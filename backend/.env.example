# ─────────────────────────────────────────────────────────────────────────────
# GridPulse AI (GridPilot AI) Backend — Environment Variables Template
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# ─── 1. Groq Cloud AI (Natural Language Explanation Engine) ──────────────────
# Required for Llama-3 natural language dispatch and degradation explanations.
# Get a free API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192

# ─── 2. Vapi Real-Time Voice (WebRTC Voice Agent) ───────────────────────────
# Required for low-latency bidirectional voice chat with the AI assistant.
# Get your keys at: https://dashboard.vapi.ai
VAPI_PUBLIC_KEY=your_vapi_public_key_here
VAPI_ASSISTANT_ID=your_vapi_assistant_id_here
VAPI_PRIVATE_KEY=your_vapi_private_api_key_here

# ─── 3. OpenAI API (Optional Fallback / Alternate LLM) ──────────────────────
# Optional: Used if you configure OpenAI models for embeddings or dispatch chat.
# Get your API key at: https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here

# ─── 4. Database Configuration ───────────────────────────────────────────────
# Default: Local SQLite database
DATABASE_URL=sqlite:///./gridpilot.db

# ─── 5. Server & Security Settings ──────────────────────────────────────────
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Application Environment: development | production
APP_ENV=development

# Logging Level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

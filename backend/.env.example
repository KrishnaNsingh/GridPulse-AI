# GridPilot AI Backend — Environment Variables
# Copy this file to .env and fill in your values

# Groq API key for AI explanations (optional — app works without it)
GROQ_API_KEY=

# Groq model to use
GROQ_MODEL=llama3-8b-8192

# Database URL (SQLite by default)
DATABASE_URL=sqlite:///./gridpilot.db

# CORS origins for the frontend
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# App environment
APP_ENV=development

# Log level
LOG_LEVEL=INFO
